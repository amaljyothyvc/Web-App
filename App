function Jobtracker() {
  const [view, setView] = useState("dashboard");
  const [jobs, setJobs] = useState([]);
  const [stats, setStats] = useState({ today: 0, thisWeek: 0, thisMonth: 0, thisYear: 0 });
  const [appliedJobs, setAppliedJobs] = useState([]);

  // Who's logged in, if anyone — checked once on load via the session token,
  // never trusted from localStorage alone without server confirmation.
  const [currentUser, setCurrentUser] = useState(null);       // job seeker
  const [currentCompany, setCurrentCompany] = useState(null); // company
  const [authChecked, setAuthChecked] = useState(false);

  function fetchJobs() {
    fetch(`${API_URL}/api/jobs`)
      .then((response) => response.json())
      .then((data) => setJobs(data))
      .catch((error) => console.error("Error fetching jobs:", error));
  }

  function checkAuth() {
   
    const userToken = localStorage.getItem("userToken");
    const companyToken = localStorage.getItem("companyToken");

    if (userToken) {
      authFetch(`${API_URL}/api/auth/me`, "userToken")
        .then((res) => res.json())
        .then((data) => {
          if (data.user) {
            setCurrentUser(data.user);
          } else {
            localStorage.removeItem("userToken");
          }
        })
        .finally(() => setAuthChecked(true));
    } else if (companyToken) {
      authFetch(`${API_URL}/api/auth/me`, "companyToken")
        .then((res) => res.json())
        .then((data) => {
          if (data.company) {
            setCurrentCompany(data.company);
          } else {
            localStorage.removeItem("companyToken");
          }
        })
        .finally(() => setAuthChecked(true));
    } else {
      setAuthChecked(true);
    }
  }

  function fetchStats() {
    if (!currentUser) return;
    authFetch(`${API_URL}/api/applications/stats`, "userToken")
      .then((response) => response.json())
      .then((data) => setStats(data))
      .catch((error) => console.error("Error fetching stats:", error));
  }

  function fetchAppliedJobs() {
    if (!currentUser) return;
    authFetch(`${API_URL}/api/applications/mine`, "userToken")
      .then((response) => response.json())
      .then((data) => setAppliedJobs(data))
      .catch((error) => console.error("Error fetching applications:", error));
  }

  function refreshApplicationData() {
    fetchStats();
    fetchAppliedJobs();
  }

  useEffect(() => {
    fetchJobs();
    checkAuth();
  }, []);

  useEffect(() => {
    if (currentUser) {
      refreshApplicationData();
    } else {
      setStats({ today: 0, thisWeek: 0, thisMonth: 0, thisYear: 0 });
      setAppliedJobs([]);
    }
  }, [currentUser]);

  useEffect(() => {
    if (view === "dashboard" && currentUser) {
      fetchStats();
    }
  }, [view]);

  function handleUserLoggedIn(user) {
    setCurrentUser(user);
    setView("dashboard");
  }

  function handleCompanyLoggedIn(company) {
    setCurrentCompany(company);
    setView("postjob");
  }

  function logoutUser() {
    authFetch(`${API_URL}/api/auth/logout`, "userToken", { method: "POST" }).catch(() => {});
    localStorage.removeItem("userToken");
    setCurrentUser(null);
    setView("dashboard");
  }

  function logoutCompany() {
    authFetch(`${API_URL}/api/auth/logout`, "companyToken", { method: "POST" }).catch(() => {});
    localStorage.removeItem("companyToken");
    setCurrentCompany(null);
    setView("dashboard");
  }

  function goToApply() {
    setView(currentUser ? "jobs" : "userAuth");
  }
  function goToPostJob() {
    setView(currentCompany ? "postjob" : "companyAuth");
  }

  function goToMyPostings() {
    setView(currentCompany ? "postings" : "companyAuth");
  }

  function goToApplied() {
    setView(currentUser ? "applications" : "userAuth");
  }

  const appliedJobIds = appliedJobs.map((a) => a.id);

  if (!authChecked) {
    return <div className="AuthLoading">Loading...</div>;
  }

  return (
    <div className="AppShell">
      <div className="ScreenArea">
        {view === "companyAuth" && (
          <CompanyAuth
            onClose={() => setView("dashboard")}
            onAuthenticated={handleCompanyLoggedIn}
          />
        )}

        {view === "userAuth" && (
          <UserAuth
            onClose={() => setView("dashboard")}
            onAuthenticated={handleUserLoggedIn}
          />
        )}

        {view === "postjob" && (
          <PostJob onDone={() => { setView("dashboard"); fetchJobs(); }} />
        )}

        {view === "jobs" && (
          <Joblisting
            jobs={jobs}
            appliedJobIds={appliedJobIds}
            isLoggedIn={!!currentUser}
            onNeedsLogin={() => setView("userAuth")}
            onApplied={refreshApplicationData}
            onEnd={() => setView("dashboard")}
          />
        )}

        {view === "applications" && (
          <MyApplications
            jobs={appliedJobs}
            onEnd={() => setView("dashboard")}
          />
        )}

        {view === "postings" && (
          <MyPostings
            onEnd={() => { setView("dashboard"); fetchJobs(); }}
          />
        )}

        {view === "dashboard" && (
          <div className="Container">
            <div className="Mainbox">
              <h2 className="header1">
                Good morning <span className="wave">👋</span>
              </h2>

              <div>
                <p className="dash">
                  {currentUser
                    ? `Signed in as ${currentUser.email}`
                    : currentCompany
                    ? `Signed in as ${currentCompany.company_name}`
                    : "Welcome to your job dashboard"}
                </p>

                {!currentUser && !currentCompany && (
                  <div className="dash-actions">
                    <button className="register" onClick={() => setView("companyAuth")}>
                      Company Login / Register
                    </button>
                    <button className="register-secondary" onClick={() => setView("userAuth")}>
                      Job Seeker Login / Sign Up
                    </button>
                  </div>
                )}

                {currentUser && (
                  <button className="logout-btn" onClick={logoutUser}>
                    {icons.logout} Log out
                  </button>
                )}
                {currentCompany && (
                  <button className="logout-btn" onClick={logoutCompany}>
                    {icons.logout} Log out
                  </button>
                )}
              </div>
            </div>

            <div className="dashboard-metric" id="job-applied-card">
              <h1 className="header2">Jobs Applied To</h1>

              {!currentUser ? (
                <p className="stats-locked">Log in as a job seeker to track your applications.</p>
              ) : (
                <div className="Stats">
                  <div className="stat-item">
                    <h4>Today</h4>
                    <strong>{stats.today}</strong>
                  </div>
                  <div className="stat-item">
                    <h4>This Week</h4>
                    <strong>{stats.thisWeek}</strong>
                  </div>
                  <div className="stat-item">
                    <h4>This Month</h4>
                    <strong>{stats.thisMonth}</strong>
                  </div>
                  <div className="stat-item">
                    <h4>This Year</h4>
                    <strong>{stats.thisYear}</strong>
                  </div>
                </div>
              )}
            </div>

            <div className="goalandjobs">
              <section className="jobs">
                <h2 className="job">Explore The Jobs</h2>
                <p className="job-count">{jobs.length} open {jobs.length === 1 ? "position" : "positions"}</p>
                <button className="find-jobs" onClick={() => setView("jobs")}>
                  Find Jobs
                </button>
              </section>

              <section className="goals">
                <h2 className="goal">My Goals</h2>
                <button className="add-goal">Add Goal</button>
              </section>
            </div>
          </div>
        )}
      </div>

      <nav className="navbar">
        <button
          className={`nav-item ${view === "dashboard" ? "nav-item-active" : ""}`}
          onClick={() => setView("dashboard")}
        >
          {icons.home}
          <span>Home</span>
        </button>

        <button
          className={`nav-item ${view === "jobs" ? "nav-item-active" : ""}`}
          onClick={() => setView("jobs")}
        >
          {icons.briefcase}
          <span>Find Jobs</span>
        </button>

        <button
          className={`nav-item ${view === "postjob" || view === "companyAuth" ? "nav-item-active" : ""}`}
          onClick={goToPostJob}
        >
          {icons.plus}
          <span>Post a Job</span>
        </button>

        <button
          className={`nav-item ${view === "postings" ? "nav-item-active" : ""}`}
          onClick={goToMyPostings}
        >
          {icons.list}
          <span>My Postings</span>
        </button>

        <button
          className={`nav-item ${view === "applications" ? "nav-item-active" : ""}`}
          onClick={goToApplied}
        >
          {icons.check}
          <span>Applied</span>
          {appliedJobIds.length > 0 && (
            <span className="nav-badge">{appliedJobIds.length}</span>
          )}
        </button>
      </nav>
    </div>
  );
}

function MyApplications({ jobs, onEnd }) {
  return (
    <div className="post-job">
      <h1>My Applications</h1>

      {jobs.length === 0 ? (
        <div className="applications-empty">
          <p>You haven't applied to any jobs yet.</p>
        </div>
      ) : (
        <div className="applications-list">
          {jobs.map((job) => (
            <div key={job.application_id} className="application-card">
              <div className="application-card-header">
                <h3 className="application-title">{job.job_title}</h3>
                <span className={`status-badge status-${job.status.toLowerCase()}`}>
                  {job.status}
                </span>
              </div>
              <p className="application-company">{job.company_name}</p>
              <p className="application-location">{job.location}</p>
            </div>
          ))}
        </div>
      )}

      {onEnd && (
        <div className="back-button-container">
          <button onClick={onEnd} className="back-btn">
            Back to Dashboard
          </button>
        </div>
      )}
    </div>
  );
}

function MyPostings({ onEnd }) {
  const [postings, setPostings] = useState([]);
  const [expandedJobId, setExpandedJobId] = useState(null);
  const [applicants, setApplicants] = useState([]);
  const [loading, setLoading] = useState(true);

  function fetchPostings() {
    setLoading(true);
    authFetch(`${API_URL}/api/companies/me/jobs`, "companyToken")
      .then((res) => res.json())
      .then((data) => setPostings(data))
      .catch((err) => console.error("Error fetching postings:", err))
      .finally(() => setLoading(false));
  }

  useEffect(() => {
    fetchPostings();
  }, []);

  function toggleApplicants(jobId) {
    if (expandedJobId === jobId) {
      setExpandedJobId(null);
      return;
    }
    setExpandedJobId(jobId);
    authFetch(`${API_URL}/api/jobs/${jobId}/applications`, "companyToken")
      .then((res) => res.json())
      .then((data) => setApplicants(data))
      .catch((err) => console.error("Error fetching applicants:", err));
  }

  async function updateStatus(applicationId, status) {
    try {
      const response = await authFetch(`${API_URL}/api/applications/${applicationId}/status`, "companyToken", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status })
      });
      if (!response.ok) {
        const err = await response.json();
        alert(`Error: ${err.error}`);
        return;
      }
      setApplicants((prev) => prev.map((a) => (a.id === applicationId ? { ...a, status } : a)));
    } catch (error) {
      console.error("Failed to update status:", error);
      alert("Something went wrong updating the status.");
    }
  }

  async function deleteJob(jobId) {
    if (!confirm("Delete this job posting? This cannot be undone.")) return;
    try {
      const response = await authFetch(`${API_URL}/api/jobs/${jobId}`, "companyToken", { method: "DELETE" });
      if (!response.ok) {
        const err = await response.json();
        alert(`Error: ${err.error}`);
        return;
      }
      setPostings((prev) => prev.filter((j) => j.id !== jobId));
    } catch (error) {
      console.error("Failed to delete job:", error);
      alert("Something went wrong deleting the job.");
    }
  }

  return (
    <div className="post-job">
      <h1>My Postings</h1>

      {loading ? (
        <p className="applications-empty">Loading...</p>
      ) : postings.length === 0 ? (
        <div className="applications-empty">
          <p>You haven't posted any jobs yet.</p>
        </div>
      ) : (
        <div className="applications-list">
          {postings.map((job) => (
            <div key={job.id} className="application-card">
              <div className="application-card-header">
                <h3 className="application-title">{job.job_title}</h3>
                <button className="delete-job-btn" onClick={() => deleteJob(job.id)}>
                  Delete
                </button>
              </div>
              <p className="application-location">{job.location}</p>
              <button className="toggle-applicants-btn" onClick={() => toggleApplicants(job.id)}>
                {expandedJobId === job.id ? "Hide" : "View"} Applicants ({job.applicant_count})
              </button>

              {expandedJobId === job.id && (
                <div className="applicants-panel">
                  {applicants.length === 0 ? (
                    <p className="applications-empty">No applicants yet.</p>
                  ) : (
                    applicants.map((a) => (
                      <div key={a.id} className="applicant-row">
                        <span>{a.applicant_email}</span>
                        <select value={a.status} onChange={(e) => updateStatus(a.id, e.target.value)}>
                          <option value="Applied">Applied</option>
                          <option value="Reviewing">Reviewing</option>
                          <option value="Rejected">Rejected</option>
                          <option value="Hired">Hired</option>
                        </select>
                      </div>
                    ))
                  )}
                </div>
              )}
            </div>
          ))}
        </div>
      )}

      {onEnd && (
        <div className="back-button-container">
          <button onClick={onEnd} className="back-btn">
            Back to Dashboard
          </button>
        </div>
      )}
    </div>
  );
}

function PostJob({ onDone }) {
  const [job, setJob] = useState({
    job_title: "",
    location: "",
    experience: "",
    salary: "",
    skills: "",
    description: "",
    deadline: "",
  });

  function handleChange(e) {
    setJob({ ...job, [e.target.name]: e.target.value });
  }

  async function handleSubmit(e) {
    e.preventDefault();

    try {
      const response = await authFetch(`${API_URL}/api/jobs`, "companyToken", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(job),
      });

      if (!response.ok) {
        const err = await response.json();
        alert(`Error: ${err.error}`);
        return;
      }

      await response.json();
      alert("Job posted successfully!");

      setJob({
        job_title: "",
        location: "",
        experience: "",
        salary: "",
        skills: "",
        description: "",
        deadline: "",
      });

      if (onDone) onDone();
    } catch (error) {
      console.error("Failed to post job:", error);
      alert("Something went wrong — could not reach the server. Is it running on localhost:3000?");
    }
  }

  return (
    <div className="post-job">
      <h1>Post a Job</h1>
      <form onSubmit={handleSubmit}>
        <input name="job_title" placeholder="Job Title" value={job.job_title} onChange={handleChange} />
        <input name="location" placeholder="Location" value={job.location} onChange={handleChange} />
        <input name="experience" placeholder="Experience" value={job.experience} onChange={handleChange} />
        <input name="salary" placeholder="Salary" value={job.salary} onChange={handleChange} />
        <input name="skills" placeholder="Required Skills" value={job.skills} onChange={handleChange} />
        <textarea name="description" placeholder="Job Description" value={job.description} onChange={handleChange} />
        <input type="date" name="deadline" value={job.deadline} onChange={handleChange} />
        <button type="submit">Publish Job</button>
      </form>
    </div>
  );
}

export default function App() {
  return (
    <div>
      <Jobtracker />
    </div>
  );
}
