import React, { useEffect, useState } from "react";
import "./job-listing-modern.css";

function JobListing({ onEnd, jobs = [] }) {
  const [appliedIds, setAppliedIds] = useState(() => {
    const saved = localStorage.getItem("appliedJobIds");
    return saved ? JSON.parse(saved) : [];
  });

  const [savedIds, setSavedIds] = useState([]);

  const [applyingId, setApplyingId] = useState(null);

  useEffect(() => {
    localStorage.setItem(
      "appliedJobIds",
      JSON.stringify(appliedIds)
    );
  }, [appliedIds]);

  const parseSkills = (skills) => {
    if (Array.isArray(skills)) {
      return skills;
    }

    if (typeof skills === "string") {
      return skills
        .split(",")
        .map((skill) => skill.trim())
        .filter(Boolean);
    }

    return [];
  };

  async function handleApply(jobId) {
    if (
      appliedIds.includes(jobId) ||
      applyingId === jobId
    ) {
      return;
    }

    setApplyingId(jobId);

    try {
      const response = await fetch(
        "http://localhost:3000/api/applications",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            job_id: jobId,
          }),
        }
      );

      if (!response.ok) {
        const error = await response.json();

        alert(
          `Error: ${error.error || "Application failed"}`
        );

        return;
      }

      /*
        Store the job ID
      */
      setAppliedIds((current) => [
        ...current,
        jobId,
      ]);

      /*
        Store application date/time
      */
      const existingApplications = JSON.parse(
        localStorage.getItem("applicationDates") || "{}"
      );

      existingApplications[jobId] =
        new Date().toISOString();

      localStorage.setItem(
        "applicationDates",
        JSON.stringify(existingApplications)
      );

      /*
        Tell App.jsx that a new application happened
      */
      window.dispatchEvent(
        new Event("applicationUpdated")
      );

    } catch (error) {
      console.error(
        "Failed to apply:",
        error
      );

      alert(
        "Something went wrong — could not reach the server."
      );
    } finally {
      setApplyingId(null);
    }
  }

  function handleSave(jobId) {
    setSavedIds((current) =>
      current.includes(jobId)
        ? current.filter(
            (id) => id !== jobId
          )
        : [...current, jobId]
    );
  }

  return (
    <main className="job-listing-page">
      <div className="job-listing-shell">

        {/* HEADER */}

        <header className="job-listing-header">

          <div>

            <div className="job-listing-eyebrow">
              <span />
              Explore opportunities
            </div>

            <h2>
              Available jobs
            </h2>

            <p>
              {jobs.length} open{" "}
              {jobs.length === 1
                ? "position"
                : "positions"}{" "}
              matched to your profile
            </p>

          </div>

          <div className="job-listing-count">

            <div>
              <strong>
                {jobs.length}
              </strong>

              <span>
                open roles
              </span>
            </div>

            <div>
              <strong>
                {appliedIds.length}
              </strong>

              <span>
                jobs applied
              </span>
            </div>

          </div>

        </header>

        {/* JOBS */}

        <div className="job-list-grid">

          {jobs.map((job) => {

            const isApplied =
              appliedIds.includes(job.id);

            const isSaved =
              savedIds.includes(job.id);

            const isApplying =
              applyingId === job.id;

            const skills =
              parseSkills(job.skills);

            return (
              <article
                className="job-list-card"
                key={job.id}
              >

                <div className="job-card-topline">

                  <span className="job-type-pill">
                    Open role
                  </span>

                  {job.deadline && (
                    <span className="job-deadline">
                      Deadline {job.deadline}
                    </span>
                  )}

                </div>

                <div className="job-card-heading">

                  <div className="company-monogram">
                    {(job.company_name || "C")
                      .slice(0, 1)
                      .toUpperCase()}
                  </div>

                  <div>

                    <h3>
                      {job.job_title}
                    </h3>

                    <p className="job-company">
                      {job.company_name}
                    </p>

                    <p className="job-location">
                      <span>⌖</span>
                      {job.location}
                    </p>

                  </div>

                </div>

                <div className="job-meta-row">

                  <span>
                    <small>
                      Experience
                    </small>

                    <b>
                      {job.experience}
                    </b>
                  </span>

                  <span>
                    <small>
                      Salary
                    </small>

                    <b>
                      {job.salary}
                    </b>
                  </span>

                </div>

                {skills.length > 0 && (
                  <div className="job-skill-list">

                    {skills.map(
                      (skill, index) => (
                        <span
                          key={`${skill}-${index}`}
                        >
                          {skill}
                        </span>
                      )
                    )}

                  </div>
                )}

                <p className="job-description">
                  {job.description}
                </p>

                <div className="job-action-row">

                  <button
                    className={`job-apply-button ${
                      isApplied
                        ? "is-applied"
                        : ""
                    }`}
                    onClick={() =>
                      handleApply(job.id)
                    }
                    disabled={
                      isApplied ||
                      isApplying
                    }
                  >

                    {isApplied
                      ? "✓ Applied"
                      : isApplying
                      ? "Applying…"
                      : "Apply now →"}

                  </button>

                  <button
                    className={`job-save-button ${
                      isSaved
                        ? "is-saved"
                        : ""
                    }`}
                    onClick={() =>
                      handleSave(job.id)
                    }
                    aria-label={
                      isSaved
                        ? "Remove saved job"
                        : "Save job"
                    }
                  >

                    {isSaved
                      ? "★ Saved"
                      : "☆ Save"}

                  </button>

                </div>

              </article>
            );
          })}

        </div>

        {onEnd && (
          <button
            className="job-done-button"
            onClick={onEnd}
          >
            Back to dashboard
          </button>
        )}

      </div>
    </main>
  );
}

export default JobListing;
