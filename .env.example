# Application
PORT=3000
NODE_ENV=development
# Set a long, random secret before deployment (for example: openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-secret
# Use a persistent mounted volume in production, e.g. /var/data/jobs.db
DB_PATH=./data/jobs.db
# Used only for cross-origin development hosting; omit for same-origin production.
FRONTEND_URL=http://localhost:5173

# Optional email delivery for job alerts. In-app alerts work without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=JobApp <notifications@example.com>
