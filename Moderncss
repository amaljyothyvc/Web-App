.job-listing-page {
  min-height: 100vh;
  padding: 42px 20px 90px;
  background: radial-gradient(circle at 85% 0%, rgba(124, 92, 255, .14), transparent 32%), #f5f6fb;
  color: #17152a;
  font-family: 'DM Sans', system-ui, sans-serif;
}
.job-listing-shell { width: min(100%, 1020px); margin: 0 auto; }
.job-listing-header { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 30px; }
.job-listing-eyebrow { display: flex; align-items: center; gap: 8px; color: #6d51d9; font-size: 11px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
.job-listing-eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: #7c5cff; box-shadow: 0 0 0 5px rgba(124,92,255,.12); }
.job-listing-header h2 { margin: 13px 0 5px; font-family: 'Space Grotesk', sans-serif; font-size: clamp(30px, 5vw, 48px); letter-spacing: -.07em; line-height: 1; }
.job-listing-header p { margin: 0; color: #77758b; font-size: 14px; }
.job-listing-count { display: grid; min-width: 100px; place-items: center; border: 1px solid rgba(124,92,255,.15); border-radius: 18px; padding: 14px 18px; background: rgba(255,255,255,.66); box-shadow: 0 10px 28px rgba(30,24,77,.05); }
.job-listing-count strong { color: #6d51d9; font-family: 'Space Grotesk', sans-serif; font-size: 28px; line-height: 1; }.job-listing-count span { margin-top: 4px; color: #8e8ba0; font-size: 10px; text-transform: uppercase; letter-spacing: .08em; }
.job-list-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.job-list-card { position: relative; overflow: hidden; border: 1px solid rgba(255,255,255,.82); border-radius: 20px; padding: 22px; background: rgba(255,255,255,.84); box-shadow: 0 10px 30px rgba(30,24,77,.055), 0 2px 6px rgba(30,24,77,.035); transition: transform .22s cubic-bezier(.23,1,.32,1), box-shadow .22s ease, border-color .22s ease; }
.job-list-card::after { position: absolute; top: 0; right: 0; width: 120px; height: 120px; border-radius: 50%; background: radial-gradient(circle, rgba(124,92,255,.12), transparent 70%); content: ''; pointer-events: none; }
.job-list-card:hover { border-color: rgba(124,92,255,.3); box-shadow: 0 20px 40px rgba(30,24,77,.11); transform: translateY(-5px); }
.job-card-topline { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 19px; }.job-type-pill { border-radius: 999px; padding: 5px 9px; color: #6d51d9; background: #f0ebff; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; }.job-deadline { color: #b26c35; font-size: 11px; }
.job-card-heading { position: relative; z-index: 1; display: flex; align-items: flex-start; gap: 12px; }.company-monogram { display: grid; width: 42px; height: 42px; flex: none; place-items: center; border-radius: 13px; color: #fff; background: linear-gradient(135deg, #9278ff, #5c3fc9); box-shadow: 0 8px 18px rgba(92,63,201,.2); font-family: 'Space Grotesk', sans-serif; font-size: 18px; font-weight: 700; }.job-card-heading h3 { margin: 0; color: #24203a; font-family: 'Space Grotesk', sans-serif; font-size: 20px; font-weight: 700; letter-spacing: -.045em; line-height: 1.1; }.job-company { margin: 5px 0 0; color: #5f5b73; font-size: 13px; font-weight: 600; }.job-location { margin: 4px 0 0; color: #9a97a7; font-size: 12px; }.job-location span { margin-right: 5px; color: #7c5cff; }
.job-meta-row { display: flex; align-items: center; gap: 26px; margin: 22px 0 15px; border-top: 1px solid rgba(35,28,72,.08); border-bottom: 1px solid rgba(35,28,72,.08); padding: 13px 0; }.job-meta-row span { display: grid; gap: 4px; }.job-meta-row small { color: #9a97a7; font-size: 10px; text-transform: uppercase; letter-spacing: .08em; }.job-meta-row b { color: #373247; font-size: 12px; font-weight: 700; }
.job-skill-list { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 15px; }.job-skill-list span { border: 1px solid #e5e0ff; border-radius: 999px; padding: 5px 9px; color: #6451ad; background: #f6f3ff; font-size: 11px; font-weight: 600; }.job-description { display: -webkit-box; overflow: hidden; min-height: 44px; margin: 0 0 18px; color: #706d7d; font-size: 13px; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.job-action-row { display: flex; gap: 9px; }.job-apply-button, .job-save-button, .job-done-button { border-radius: 11px; padding: 11px 15px; font-size: 12px; font-weight: 700; transition: transform .18s ease, box-shadow .18s ease, background .18s ease; }.job-apply-button { border: 0; color: #fff; background: linear-gradient(135deg, #8a6bff, #6446d7); box-shadow: 0 8px 18px rgba(91,63,190,.2); }.job-apply-button:hover:not(:disabled) { box-shadow: 0 12px 24px rgba(91,63,190,.3); transform: translateY(-2px); }.job-apply-button.is-applied { color: #487361; background: #e5f4eb; box-shadow: none; }.job-save-button { border: 1px solid rgba(124,92,255,.2); color: #6d51d9; background: rgba(255,255,255,.6); }.job-save-button:hover, .job-save-button.is-saved { border-color: #7c5cff; background: #f4f0ff; transform: translateY(-2px); }.job-done-button { display: block; margin: 28px auto 0; border: 1px solid rgba(35,28,72,.12); color: #555166; background: rgba(255,255,255,.68); }.job-done-button:hover { color: #6d51d9; background: #fff; transform: translateY(-2px); }
@media (max-width: 700px) { .job-listing-page { padding: 28px 16px 70px; }.job-listing-header { align-items: flex-start; }.job-listing-count { min-width: 78px; padding: 11px 12px; }.job-listing-count strong { font-size: 23px; }.job-list-grid { grid-template-columns: 1fr; } }
@media (max-width: 430px) { .job-listing-header { display: block; }.job-listing-count { display: inline-grid; margin-top: 16px; }.job-list-card { padding: 18px; }.job-action-row { flex-wrap: wrap; }.job-apply-button, .job-save-button { flex: 1; } }
